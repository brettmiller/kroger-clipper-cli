#!/usr/bin/env bash
# Launcher intended to be symlinked onto PATH, e.g.
#   ln -s "$PWD/kroger-clipper" ~/.local/bin/kroger-clipper
set -euo pipefail

# Resolve this script's real location. $0 is the symlink when invoked through
# one, so follow the chain to find the repo rather than the link's directory.
source=${BASH_SOURCE[0]}
while [ -L "$source" ]; do
    dir=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [ "${source:0:1}" = "/" ] || source=$dir/$source
done
repo=$(cd -P "$(dirname "$source")" && pwd)

if ! command -v uv >/dev/null 2>&1; then
    echo "kroger-clipper: uv is not on PATH (https://docs.astral.sh/uv/)" >&2
    exit 127
fi

# --project keeps the caller's working directory intact, unlike --directory.
exec uv run --quiet --project "$repo" kroger-clipper "$@"
