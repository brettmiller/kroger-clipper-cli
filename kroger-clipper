#!/usr/bin/env python3
"""Launcher intended to be symlinked onto PATH, e.g.

    ln -s "$PWD/kroger-clipper" ~/.local/bin/kroger-clipper
"""

import os
import shutil
import sys
from pathlib import Path

# resolve() follows the whole symlink chain, so this finds the repo rather than
# whichever directory the symlink happens to live in.
REPO = Path(__file__).resolve().parent

uv = shutil.which("uv")
if uv is None:
    sys.exit("kroger-clipper: uv is not on PATH — see https://docs.astral.sh/uv/")

# --project keeps the caller's working directory intact, unlike --directory.
# exec rather than subprocess so signals and the exit code pass straight through.
os.execv(uv, [uv, "run", "--quiet", "--project", str(REPO), "kroger-clipper", *sys.argv[1:]])
